# Token del bot de Discord (obtenido en https://discord.com/developers/applications)
DISCORD_TOKEN=tu_token_aqui

# Client ID / Application ID de la aplicación de Discord
CLIENT_ID=tu_client_id_aqui

# (Opcional) ID de un servidor específico para pruebas rápidas de comandos Slash
# Si se deja vacío, los comandos se registrarán globalmente (puede tardar unos minutos en propagarse)
GUILD_ID=
